import math
import matplotlib.pyplot as plt
import numpy as np


def get_divisors(n):
    """Return a sorted list of all positive divisors of n."""
    if not isinstance(n, (int, np.integer)) or int(n) < 1:
        raise ValueError("n must be a positive integer")
    n = int(n)

    divisors = set()
    for i in range(1, int(math.isqrt(n)) + 1):
        if n % i == 0:
            divisors.add(i)
            divisors.add(n // i)
    return sorted(divisors)


def difference(n=None):
    """Return the difference between sum(divisors) and 2*n, or print values for 1..999."""
    if n is None:
        for i in range(1, 10000):
            diff = sum(get_divisors(i)) - 2 * i
            print(f"Difference for {i}: {diff}")
        return None

    if not isinstance(n, (int, np.integer)) or int(n) < 1:
        raise ValueError("n must be a positive integer")

    return sum(get_divisors(int(n))) - 2 * int(n)


def plot_difference(max_n=10000):
    """Plot the absolute difference between the sum of divisors and 2*n."""
    x = np.arange(1, max_n)
    y = np.array([(sum(get_divisors(i)) - 2 * i) for i in x])

    positive_mask = y > 0
    coefficients1 = np.polyfit(x, y, 1)
    linear_function = np.poly1d(coefficients1)


    plt.figure(figsize=(10, 6))
    plt.scatter(x, y, color="#7CB342", alpha=0.5, s=10, label="Difference")
    plt.plot(x, linear_function(x), color="#2E7D32", linestyle="-", linewidth=2, label="Linear trend")
    reference_x = np.linspace(min(x), max(x), 200)
    plt.plot(reference_x, -reference_x, color="#415d43", linestyle="-", linewidth=1, label="y = -x")
    plt.plot(reference_x, -reference_x / 2, color="#415d43", linestyle="-", linewidth=1, label="y = -x/2")
    plt.plot(reference_x, -(2 * reference_x) / 3, color="#415d43", linestyle="-", linewidth=1, label="y = -2x/3")
    plt.plot(reference_x, - reference_x / 4, color="#415d43", linestyle="-", linewidth=1, label="y = -x/4")
    plt.plot(reference_x, reference_x / 3, color="#415d43", linestyle="-", linewidth=1, label="y = x/3")
    #plt.plot(reference_x, (134*reference_x) / 77, color="#415d43", linestyle="-", linewidth=1, label="y = 77x/134") ""note that this is not a trend line, but it does show that not all values fall onto specific lines""
    
         
   
    plt.xlabel("Number")
    plt.ylabel("Difference")
    plt.title("Difference between sum of divisors and the divisor itself")
    plt.grid(alpha=0.3)
    plt.legend()
    plt.tight_layout()
    plt.show()

           


if __name__ == "__main__":
    plot_difference()
        
